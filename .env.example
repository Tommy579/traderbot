# Alpaca Paper Trading — https://app.alpaca.markets/paper/dashboard/overview
# Générez des clés "Paper" et collez-les ici. Ne commitez jamais ce fichier.
ALPACA_API_KEY=PK_VOTRE_CLE_PAPER
ALPACA_SECRET_KEY=VOTRE_SECRET_PAPER

# L'URL est verrouillée sur le paper endpoint par la configuration.
# Toute autre valeur (notamment api.alpaca.markets) fait échouer le démarrage.
ALPACA_TRADING_URL=https://paper-api.alpaca.markets

# Flux de données : iex (gratuit) ou sip (abonnement payant).
DATA_FEED=iex

# Univers de trading (CSV) et timeframe Alpaca.
# 12 valeurs liquides et sectoriellement variées. SPY est la référence
# (BENCHMARK_SYMBOL) : s'il apparaît ici par erreur, il est retiré
# automatiquement de l'univers tradable.
SYMBOLS=NVDA,AMD,AVGO,PLTR,MSFT,AMZN,META,XOM,NEE,LLY,JPM,COST
TIMEFRAME=1Day
LOOKBACK_DAYS=400

# Poche de repli défensive automatique (Safe Haven / Cash Sweep)
SAFE_HAVEN_ENABLED=true
SAFE_HAVEN_SYMBOLS=BRK.B,WMT,KO
CASH_BUFFER_PCT=0.10
MAX_SAFE_HAVEN_TOTAL_PCT=0.50
REGIME_SMA_PERIOD=200

# Planchers de sécurité, sanctuarisation de cash et écrémage partiel
WITHDRAWABLE_CASH_FLOOR_USD=0.0
EQUITY_HARD_FLOOR_USD=0.0
PARTIAL_TAKE_PROFIT_PCT=0.20
PARTIAL_TAKE_PROFIT_SELL_RATIO=0.50
MAX_SINGLE_POSITION_WEIGHT=0.25

# Boucle paper trading.
POLL_INTERVAL_SECONDS=60
MARKET_TIMEZONE=America/New_York

# Analyse sans transmission d'ordre (true/false).
DRY_RUN=false

# État persistant et logs.
STATE_DIR=state
LOG_LEVEL=INFO
# LOG_FILE=state/trading-bot.log

# --- Profil de risque (facultatif : les valeurs par défaut sont prudentes) ---
# RISK_PER_TRADE_PCT=0.01
# MAX_POSITION_PCT=0.20
# MAX_GROSS_EXPOSURE_PCT=0.80
# MAX_OPEN_POSITIONS=5
# ATR_STOP_MULTIPLE=2.0
# TRAILING_ATR_MULTIPLE=3.0
# TRAILING_ACTIVATION_R=1.0
# MAX_DAILY_LOSS_PCT=0.03
# MAX_DRAWDOWN_PCT=0.15
# MIN_ORDER_NOTIONAL=10
# FRACTIONAL_SHARES=true
# --- Automatisation et notifications (Phase 4) ---
# Benchmark du regime de marche et de la force relative (jamais trade).
BENCHMARK_SYMBOL=SPY
# Plafonds desserres quand le benchmark clôture au-dessus de sa SMA 200.
# BULL_GROSS_EXPOSURE_PCT=0.90
# BULL_MAX_POSITION_PCT=0.30

# Webhook de fin de cycle (equite, signaux, ordres). Absent = silence.
# Discord : WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
# Telegram : WEBHOOK_URL=https://api.telegram.org/bot<TOKEN>/sendMessage
#            WEBHOOK_FORMAT=telegram
#            WEBHOOK_CHAT_ID=123456789
# WEBHOOK_TOKEN n'est utile que pour un endpoint public qui exige un secret.
# WEBHOOK_URL=
# WEBHOOK_FORMAT=discord
# WEBHOOK_CHAT_ID=
# WEBHOOK_TOKEN=

# Publication des statistiques dans le depot GitHub (GitHub Pages).
# Le bot commite docs/data/stats.json ; Pages sert ce fichier tel quel.
# Le jeton doit avoir le droit « Contents: read and write » sur ce depot.
# ATTENTION : le depot doit etre PUBLIC pour Pages gratuit -> les stats le sont aussi.
# STATS_GITHUB_REPO=Tommy579/traderbot
# STATS_GITHUB_TOKEN=
# STATS_GITHUB_PATH=docs/data/stats.json
# STATS_GITHUB_BRANCH=main

# --- Filtre de sentiment des actualités (Alpaca News/Benzinga + OpenRouter) ---
# Refuse un nouvel achat quand l'actualité récente du titre est franchement
# négative, et liquide une position sur menace critique. Fail-safe : une panne
# d'API produit un score neutre, donc n'empêche jamais le bot de tourner.
# NEWS_FILTER_ENABLED=false restaure exactement le comportement d'origine.
NEWS_FILTER_ENABLED=true
# Clé OpenRouter (https://openrouter.ai/keys). Absente : le filtre existe mais
# reste neutre, aucun achat n'est refusé.
# OPENROUTER_API_KEY=
# Modèle OpenRouter par défaut
OPENROUTER_MODEL=google/gemini-3.8-flash
# Fenêtre d'actualités analysée, en heures.
# NEWS_LOOKBACK_HOURS=24
# Plafond d'articles transmis au modèle par appel. C'est, avec le cache des
# articles déjà notés (state/processed_news_ids.json), le principal levier de
# coût : sans article nouveau, l'API n'est pas appelée du tout.
# NEWS_MAX_ARTICLES=10
# Délai maximal d'un appel OpenRouter, en secondes (timeout fail-safe 5s).
# NEWS_TIMEOUT_SECONDS=5.0
# Seuil de refus d'un achat (score <= -0.60) et seuil de sortie d'urgence
# (score <= -0.85). La panique doit rester au moins aussi grave que le veto.
# NEWS_VETO_THRESHOLD=-0.60
# NEWS_PANIC_EXIT_THRESHOLD=-0.85

# --- Stratégie Bouclier + Épée (Shield + Sword / Core-Satellite CPPI) ---
# SHIELD_ALLOCATION_PCT=0.70
# SWORD_ALLOCATION_PCT=0.30
# SWORD_TOP_N=3
# SWORD_REBALANCE_DAYS=20
# SWORD_TREND_SMA=100
# SWORD_STOP_ATR_MULTIPLIER=5.0
# SWORD_MAX_LOSS_PCT=0.12
# RISK_FREE_RATE_ANNUAL=0.045
# SHIELD_SYMBOL=SGOV

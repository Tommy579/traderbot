# Alternative cron au timer systemd (crontab -e).
#
# CRON_TZ fixe le fuseau du planificateur sur la place de cotation (Wall Street).
# Double vitesse :
# - Vigie horaire (10h à 15h NY / 16h à 21h Paris) : surveillance des stops et alertes news
# - Cycle complet (15h55 NY / 21h55 Paris) : signaux journaliers 1Day, entrées/sorties et cash sweep

CRON_TZ=America/New_York
0 10-15 * * 1-5 /home/tom/Documents/trader/tradingbot live --watch-only >> /home/tom/Documents/trader/state/cron.log 2>&1
55 15 * * 1-5 /home/tom/Documents/trader/tradingbot live --once >> /home/tom/Documents/trader/state/cron.log 2>&1

# Timer systemd UTILISATEUR : cycle complet quotidien à 15:55 heure de New York
# (21:55 heure de Paris), 5 minutes avant la clôture de Wall Street.
# Les jours fériés sont filtrés par le bot lui-même (cycle ignoré si marché fermé).

[Unit]
Description=TradingBot Alpaca - cycle complet quotidien (15:55 New York)

[Timer]
OnCalendar=Mon..Fri *-*-* 15:55:00 America/New_York
Persistent=false
Unit=tradingbot.service

[Install]
WantedBy=timers.target
